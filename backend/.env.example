# Copy this file to .env and fill in values as needed.
# The core text-based MVP works with NO keys set at all.

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retrieval tuning (defaults are fine for the hackathon demo)
RETRIEVAL_THRESHOLD=0.08
TOP_K_RESULTS=2

# --- Bonus: voice + Indic translation via Bhashini (free, gov of India) ---
# Register at https://bhashini.gov.in to get these. Leave blank to disable;
# the frontend will automatically use the browser's Web Speech API instead.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# --- Optional: only needed if you wire up an LLM to phrase answers more
# naturally on top of the retrieved, cited content. Never required for
# the safety layer or the citations themselves to work. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
